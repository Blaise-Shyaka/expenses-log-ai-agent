DEEPSEEK_API_KEY=sk-...
# Set this to your Ollama base URL to use a local model instead of DeepSeek (e.g. http://localhost:11434)
OLLAMA_URL=
# Optional — get from https://smith.langchain.com/settings
LANGSMITH_API_KEY=lsv2...
# Optional — set to true to enable passive tracing to LangSmith
LANGSMITH_TRACING=true
# Optional — organizes traces by project in LangSmith
LANGSMITH_PROJECT=momo-expenses
# Port this agent listens on
PORT=8123
# URL of the MCP tool server
MCP_URL=http://localhost:8124

AUTH_JWKS_URI=http://localhost:8001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8001
AUTH_TOKEN_URL=http://localhost:8001/oauth/token
AGENT_CLIENT_ID=svc-agent
AGENT_CLIENT_SECRET=
AUTH_REQUIRED=true
