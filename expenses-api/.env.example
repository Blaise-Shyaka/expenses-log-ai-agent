MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=expenses
MYSQL_USER=expenses_user
MYSQL_PASSWORD=change-me
PORT=8000

DATABASE_URL=mysql+aiomysql://USER:PW@localhost:3306/DB
ALEMBIC_URL=mysql+pymysql://USER:PW@localhost:3306/DB

# Shared by the REST API and the agent at /agent
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
AUTH_ISSUER=https://auth.example.com
# Turns off token checks for both /api/v1 and /agent. Never in production
AUTH_REQUIRED=true
# Audience for /api/v1 only. Keep expenses-api while expenses-mcp calls the API with its
# svc-mcp token. /agent always checks user tokens for audience expenses-agent
AUTH_AUDIENCE=expenses-api

DEBUG=false

# --- Agent (/agent) ---
# The agent stays off unless OLLAMA_URL or DEEPSEEK_API_KEY has a value
DEEPSEEK_API_KEY=sk-...
# Set this to your Ollama base URL to use a local model instead of DeepSeek (e.g. http://localhost:11434). Leave blank to use DeepSeek
OLLAMA_URL=
# Optional — cap on model calls per second for the whole process, shared by all users. Unset means no limit
LLM_REQUESTS_PER_SECOND=
# URL of the MCP tool server the agent loads its tools from
MCP_URL=http://localhost:8124
# Client credentials for the agent's service token to the MCP server
AUTH_TOKEN_URL=https://auth.example.com/oauth/token
AGENT_CLIENT_ID=svc-agent
AGENT_CLIENT_SECRET=
# Optional — get from https://smith.langchain.com/settings
LANGSMITH_API_KEY=
# Optional — set to true to enable passive tracing to LangSmith
LANGSMITH_TRACING=false
# Optional — organizes traces by project in LangSmith
LANGSMITH_PROJECT=momo-expenses
