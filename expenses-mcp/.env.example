# Port this MCP server listens on
PORT=8124
# URL of the expenses REST API
EXPENSES_API_URL=http://localhost:8000/api/v1

# --- Inbound bearer auth (verifying callers) ---
# Set to false for dev bypass (loud warning)
AUTH_REQUIRED=true
# Auth service base URL (authorization server)
AUTH_URL=http://localhost:8001
# JWKS endpoint for RS256 key verification
AUTH_JWKS_URI=http://localhost:8001/.well-known/jwks.json
# Expected JWT issuer claim
AUTH_ISSUER=http://localhost:8001
# Public base URL of this MCP server
MCP_BASE_URL=http://localhost:8124

# --- Outbound service token (calling expenses-api) ---
# OAuth client_credentials client ID
MCP_CLIENT_ID=svc-mcp
# OAuth client_credentials client secret
MCP_CLIENT_SECRET=change-me
# Token endpoint for client_credentials grant
AUTH_TOKEN_URL=http://localhost:8001/oauth/token
